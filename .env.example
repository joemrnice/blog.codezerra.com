# Environment Configuration
# Copy this file to .env and update with your settings

# Database Configuration
DB_HOST=localhost
DB_NAME=codezerra_blog
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# Security
SESSION_SECRET=your_random_session_secret_here_change_this
CSRF_SECRET=your_random_csrf_secret_here_change_this

# Site Configuration
SITE_URL=https://blog.codezerra.com
ADMIN_EMAIL=admin@codezerra.com

# File Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Error Reporting (set to false in production)
DISPLAY_ERRORS=false
ERROR_LOG_PATH=/var/log/codezerra_blog_errors.log

# Chatbot (optional AI integration)
OPENAI_API_KEY=
CHATBOT_ENABLED=true
